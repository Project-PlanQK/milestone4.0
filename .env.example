# Azure OpenAI Configuration (Required)
# Get these from Azure Portal → OpenAI Service
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
ENDPOINT_URL=https://your-resource-name.openai.azure.com/

# Azure AI Search Configuration (Required)
# Get these from Azure Portal → AI Search Service
SEARCH_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_KEY=your_azure_search_admin_key_here

# Azure Application Insights (Optional - for monitoring)
# Get this from Azure Portal → Application Insights → Properties
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.in.applicationinsights.azure.com/

# Server Configuration (Optional)
# Port for the Gradio application (default: 8080)
PORT=8080

# ============================================================
# INSTRUCTIONS
# ============================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual Azure credentials above
#
# 3. Never commit .env file to version control!
#    (It's already in .gitignore)
#
# 4. For Docker: docker-compose up -d
#    For Python: export $(cat .env | xargs) && python milestone4.1/app.py
# ============================================================
